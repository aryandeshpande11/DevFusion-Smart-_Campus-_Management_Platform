generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// user account, works for student/faculty/coordinator/admin via role
model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  passwordHash     String?   @map("password_hash")
  googleId         String?   @unique @map("google_id")
  phone            String?
  roleId           String    @map("role_id")
  role             Role      @relation(fields: [roleId], references: [id])
  departmentId     String?   @map("department_id")
  department       Department? @relation(fields: [departmentId], references: [id])
  rollNumber       String?   @map("roll_number")
  semester         Int?
  skills           String[]
  linkedinUrl      String?   @map("linkedin_url")
  githubUrl        String?   @map("github_url")
  resumeUrl        String?   @map("resume_url")
  bio              String?
  avatarUrl        String?   @map("avatar_url")
  isEmailVerified  Boolean   @default(false) @map("is_email_verified")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  attendanceSessions   AttendanceSession[]   @relation("facultySessions")
  attendanceRecords    AttendanceRecord[]
  assignments          Assignment[]
  submissions          AssignmentSubmission[]
  createdEvents        Event[]               @relation("eventCreator")
  eventRegistrations   EventRegistration[]
  coordinatedClubs     Club[]                @relation("clubCoordinator")
  clubMemberships      ClubMembership[]
  createdPlacements    Placement[]
  placementApplications PlacementApplication[]
  notices              Notice[]
  notifications        Notification[]
  settings             Settings?
  activityLogs         ActivityLog[]

  @@map("users")
}

// defines what a user can do, permissions kept data-driven in jsonb
model Role {
  id          String @id @default(uuid())
  name        String @unique // student | faculty | coordinator | admin
  permissions Json
  users       User[]

  @@map("roles")
}

model Department {
  id      String   @id @default(uuid())
  name    String
  code    String   @unique
  users   User[]
  courses Course[]

  @@map("departments")
}

model Course {
  id            String   @id @default(uuid())
  name          String
  code          String
  departmentId  String   @map("department_id")
  department    Department @relation(fields: [departmentId], references: [id])
  semester      Int

  attendanceSessions AttendanceSession[]
  assignments        Assignment[]

  @@map("courses")
}

// a single class period where attendance is being taken
model AttendanceSession {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id])
  facultyId String   @map("faculty_id")
  faculty   User     @relation("facultySessions", fields: [facultyId], references: [id])
  date      DateTime
  startTime DateTime @map("start_time")
  endTime   DateTime? @map("end_time")
  qrToken   String?  @unique @map("qr_token")
  status    String   @default("open") // open | closed

  records AttendanceRecord[]

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  session    AttendanceSession @relation(fields: [sessionId], references: [id])
  studentId  String   @map("student_id")
  student    User     @relation(fields: [studentId], references: [id])
  status     String   // present | absent | late
  markedAt   DateTime @default(now()) @map("marked_at")
  method     String   // manual | qr | face

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

model Assignment {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id])
  facultyId   String   @map("faculty_id")
  faculty     User     @relation(fields: [facultyId], references: [id])
  title       String
  description String?
  attachments Json?
  rubric      Json?
  deadline    DateTime
  createdAt   DateTime @default(now()) @map("created_at")

  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String   @id @default(uuid())
  assignmentId String   @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String   @map("student_id")
  student      User     @relation(fields: [studentId], references: [id])
  fileUrl      String?  @map("file_url")
  githubLink   String?  @map("github_link")
  submittedAt  DateTime @default(now()) @map("submitted_at")
  isLate       Boolean  @default(false) @map("is_late")
  marks        Float?
  feedback     String?
  status       String   @default("pending") // pending | reviewed

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Event {
  id                    String   @id @default(uuid())
  title                 String
  description           String?
  bannerUrl             String?  @map("banner_url")
  venue                 String?
  seatsTotal             Int      @map("seats_total")
  seatsFilled            Int      @default(0) @map("seats_filled")
  registrationDeadline   DateTime @map("registration_deadline")
  speakers              Json?
  qrCode                String?  @map("qr_code")
  createdBy             String   @map("created_by")
  creator               User     @relation("eventCreator", fields: [createdBy], references: [id])
  status                String   @default("upcoming") // upcoming | ongoing | completed | cancelled

  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  event       Event    @relation(fields: [eventId], references: [id])
  studentId   String   @map("student_id")
  student     User     @relation(fields: [studentId], references: [id])
  registeredAt DateTime @default(now()) @map("registered_at")
  status      String   @default("registered") // registered | cancelled
  qrPassUrl   String?  @map("qr_pass_url")
  checkedIn   Boolean  @default(false) @map("checked_in")

  @@unique([eventId, studentId])
  @@map("event_registrations")
}

model Club {
  id            String   @id @default(uuid())
  name          String
  description   String?
  coordinatorId String   @map("coordinator_id")
  coordinator   User     @relation("clubCoordinator", fields: [coordinatorId], references: [id])
  bannerUrl     String?  @map("banner_url")

  memberships ClubMembership[]

  @@map("clubs")
}

model ClubMembership {
  id        String   @id @default(uuid())
  clubId    String   @map("club_id")
  club      Club     @relation(fields: [clubId], references: [id])
  studentId String   @map("student_id")
  student   User     @relation(fields: [studentId], references: [id])
  status    String   @default("pending") // pending | approved | rejected
  joinedAt  DateTime @default(now()) @map("joined_at")

  @@unique([clubId, studentId])
  @@map("club_memberships")
}

model Placement {
  id           String   @id @default(uuid())
  companyName  String   @map("company_name")
  jobRole      String   @map("job_role")
  eligibility  Json?
  ctc          String?
  deadline     DateTime
  description  String?
  createdBy    String   @map("created_by")
  creator      User     @relation(fields: [createdBy], references: [id])

  applications PlacementApplication[]

  @@map("placements")
}

model PlacementApplication {
  id          String   @id @default(uuid())
  placementId String   @map("placement_id")
  placement   Placement @relation(fields: [placementId], references: [id])
  studentId   String   @map("student_id")
  student     User     @relation(fields: [studentId], references: [id])
  resumeUrl   String?  @map("resume_url")
  status      String   @default("applied") // applied | shortlisted | rejected | selected
  appliedAt   DateTime @default(now()) @map("applied_at")

  @@unique([placementId, studentId])
  @@map("placement_applications")
}

model Notice {
  id               String   @id @default(uuid())
  title            String
  content          String
  targetRole       String?  @map("target_role")
  targetDepartment String?  @map("target_department")
  createdBy        String   @map("created_by")
  creator          User     @relation(fields: [createdBy], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("notices")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Settings {
  id                String @id @default(uuid())
  userId            String @unique @map("user_id")
  user              User   @relation(fields: [userId], references: [id])
  theme             String @default("light")
  notificationPrefs Json?  @map("notification_prefs")
  language          String @default("en")

  @@map("settings")
}

model ActivityLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}
